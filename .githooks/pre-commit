#!/bin/bash

PLACEHOLDER="\${PROJECT_NAME}"
FILE="settings.gradle.kts"

# Check if the file exists
if [ -f "$FILE" ]; then
    # This regex looks for rootProject.name = "anything"
    CURRENT_NAME=$(grep "rootProject.name =" "$FILE" | sed -E 's/.*"(.*)".*/\1/')

    # If the current name isn't already the placeholder, swap it
    if [ "$CURRENT_NAME" != "$PLACEHOLDER" ]; then
        # Note: we escape the $ for the placeholder in the sed command
        sed -i "s/rootProject.name = \".*\"/rootProject.name = \"$PLACEHOLDER\"/" "$FILE"
        git add "$FILE"
    fi
fi

exit 0